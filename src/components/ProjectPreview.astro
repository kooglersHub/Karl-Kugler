---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import LifeDiagram from './LifeDiagram.astro';
interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}
const { project } = Astro.props;
const data = project.data;
---

<article class="project-preview" data-category={data.category} data-reveal>
  <a class="project-visual" href={`/projects/${data.slug}/`}>
    {data.cover ? (
      <Image
        src={data.cover}
        alt={data.coverAlt || data.title}
        widths={[480, 800, 1200, 1500]}
        sizes="(max-width: 760px) 100vw, 48vw"
        format="webp"
        loading="lazy"
      />
    ) : (
      <LifeDiagram compact />
    )}
  </a>
  <div class="project-caption">
    <div>
      <span class="eyebrow">
        {data.category} / {data.status}
      </span>
      <h3>
        <a href={`/projects/${data.slug}/`}>{data.title}</a>
      </h3>
      <p>{data.description}</p>
    </div>
    <span class="project-year mono">{data.year}</span>
  </div>
</article>
