---
import { localeFor } from '../lib/locale';
const en = localeFor(Astro.url.pathname) === 'en';
const steps = en
  ? [
      ['Capture', 'Passive Modbus telemetry'],
      ['Inspect', 'Live or recorded grasps'],
      ['Freeze', 'A fixed measurement snapshot'],
      ['Compare', 'Candidate CAD placements'],
    ]
  : [
      ['Erfassen', 'Passive Modbus-Telemetrie'],
      ['Ansehen', 'Live-Ansicht oder Aufzeichnung'],
      ['Festhalten', 'Ein definierter Messstand'],
      ['Vergleichen', 'Mögliche CAD-Platzierungen'],
    ];
---

<figure class="telemetry-pipeline">
  <figcaption>
    {en
      ? 'From observation to estimation'
      : 'Von der Beobachtung zur Schätzung'}
  </figcaption>
  <ol>
    {steps.map(([title, description]) => (
      <li>
        <div>
          <strong>{title}</strong>
          <p>{description}</p>
        </div>
      </li>
    ))}
  </ol>
</figure>
