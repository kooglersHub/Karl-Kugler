---
const steps = [
  { title: 'Erfassen', description: 'Passive Modbus-Telemetrie' },
  { title: 'Ansehen', description: 'Live-Ansicht oder Aufzeichnung' },
  { title: 'Festhalten', description: 'Ein definierter Messstand' },
  { title: 'Vergleichen', description: 'Mögliche CAD-Platzierungen' },
];
---

<figure class="telemetry-pipeline" aria-label="HaptIQ-Messablauf">
  <span class="eyebrow">VON DER BEOBACHTUNG ZUR SCHÄTZUNG</span>
  <ol>
    {steps.map((step, index) => (
      <li>
        <span class="mono">0{index + 1}</span>
        <div>
          <strong>{step.title}</strong>
          <p>{step.description}</p>
        </div>
      </li>
    ))}
  </ol>
</figure>
