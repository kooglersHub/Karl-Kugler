---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const organisms = Array.from({ length: 31 }, (_, i) => ({
  x: 42 + ((i * 113 + Math.floor(i / 4) * 19) % 650),
  y: 36 + ((i * 89 + Math.floor(i / 3) * 23) % 350),
  angle: (i * 137) % 360,
  scale: 0.6 + (i % 5) * 0.16,
}));
---

<svg
  class:list={['life-diagram', { compact }]}
  viewBox="0 0 740 440"
  role="img"
  aria-label="Konzeptzeichnung einer Population künstlicher Organismen mit Ressourcen und sensorischen Verbindungen. Kein Anwendungsscreenshot."
>
  <defs>
    <pattern
      id={compact ? 'life-grid-small' : 'life-grid'}
      width="37"
      height="37"
      patternUnits="userSpaceOnUse"
    >
      <path
        d="M37 0H0V37"
        fill="none"
        stroke="currentColor"
        stroke-opacity=".09"
        stroke-width=".7"
      />
    </pattern>
  </defs>
  <rect
    width="740"
    height="440"
    fill={compact ? 'url(#life-grid-small)' : 'url(#life-grid)'}
  />
  <g fill="none" stroke="currentColor" opacity=".22">
    <circle cx="365" cy="212" r="116" stroke-dasharray="3 7" />
    <circle cx="365" cy="212" r="66" />
    <path d="m245 170 120 42 80-96m-80 96 96 84m-96-84-56 113" />
  </g>
  {Array.from({ length: 48 }, (_, i) => (
    <circle
      cx={22 + ((i * 167) % 695)}
      cy={25 + ((i * 97) % 390)}
      r="2"
      fill="currentColor"
      opacity=".35"
    />
  ))}
  {organisms.map(({ x, y, angle, scale }, i) => (
    <g transform={`translate(${x} ${y}) rotate(${angle}) scale(${scale})`}>
      <path
        d="M-12 0c0-8 9-13 18-7l9 7-9 7c-9 6-18 1-18-7Z"
        fill={i % 4 === 0 ? '#c9a47c' : '#a8b48d'}
        stroke="#35402e"
        stroke-width="1.3"
      />
      <path
        d="m-11 0-10-5m10 5-10 5M8-4l7-8m-7 16 7 8"
        stroke="#35402e"
        fill="none"
      />
      <circle cx="7" cy="-2" r="1.8" fill="#35402e" />
    </g>
  ))}
  <g
    fill="currentColor"
    font-family="monospace"
    font-size="9"
    letter-spacing="1"
  >
    <text x="22" y="420">
      POPULATION / KONZEPTSTUDIE
    </text>
    <text x="580" y="420">
      x → y ↑
    </text>
  </g>
</svg>
