---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import LifeDiagram from '../components/LifeDiagram.astro';
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const data = project.data;
---

<BaseLayout title={data.title} description={data.description}>
  <header class="case-intro container">
    <a class="back-link" href="/projects/">
      ← BACK TO PROJECTS
    </a>
    <span class="eyebrow">CASE STUDY / {data.category}</span>
    <h1>
      {data.title}
      <span class="accent">.</span>
    </h1>
    <p class="case-deck">{data.description}</p>
    <dl class="case-meta">
      <div>
        <dt>Field</dt>
        <dd>{data.category}</dd>
      </div>
      <div>
        <dt>Status / year</dt>
        <dd>
          {data.status} · {data.year}
        </dd>
      </div>
      <div>
        <dt>Tools & materials</dt>
        <dd>{data.technologies.join(' · ')}</dd>
      </div>
      <div>
        <dt>Source</dt>
        <dd>
          {data.repositoryUrl ? (
            <a class="text-link" href={data.repositoryUrl}>
              View repository ↗
            </a>
          ) : (
            'Private repository'
          )}
        </dd>
      </div>
    </dl>
  </header>
  <div class="container">
    <figure class="case-figure">
      <div
        class:list={['case-cover', { 'life-cover': data.visual === 'life' }]}
      >
        {data.cover ? (
          <Image
            src={data.cover}
            alt={data.coverAlt || data.title}
            widths={[480, 800, 1200, 1500]}
            sizes="(max-width: 760px) 95vw, 85vw"
            format="webp"
            loading="eager"
          />
        ) : (
          <LifeDiagram />
        )}
      </div>
      <figcaption>
        {data.visual === 'hand'
          ? 'HaptIQ History workspace. Synthetic test data; the displayed placement is provisional. Image: HaptIQ Hand repository.'
          : 'Original conceptual illustration of an artificial-life population. Not an application screenshot or experimental result.'}
      </figcaption>
    </figure>
  </div>
  <div class="reading-grid container">
    <aside class="reading-aside">
      <span class="eyebrow">IN THIS FIELD NOTE</span>
      <p>
        Context, decisions,
        <br />
        and what remains open.
      </p>
      {data.demoUrl && <a href={data.demoUrl}>Open live demo ↗</a>}
      {data.links.map((link) => (
        <a href={link.url}>{link.label} ↗</a>
      ))}
    </aside>
    <article class="prose">
      <slot />
      {data.gallery.map((image) => (
        <figure>
          <Image
            src={image.src}
            alt={image.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 760px) 90vw, 740px"
            format="webp"
            loading="lazy"
          />
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      ))}
    </article>
  </div>
  <div class="container page-body">
    <a class="text-link" href="/projects/">
      Explore all projects <span aria-hidden="true">↗</span>
    </a>
  </div>
</BaseLayout>
