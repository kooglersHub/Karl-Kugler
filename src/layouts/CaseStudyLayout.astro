---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import LifeDiagram from '../components/LifeDiagram.astro';
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const data = project.data;
---

<BaseLayout title={data.title} description={data.description}>
  <header class="case-intro container">
    <a class="back-link" href="/projects/">
      ← ZURÜCK ZU DEN PROJEKTEN
    </a>
    <span class="eyebrow">PROJEKTEINBLICK / {data.category}</span>
    <h1>
      {data.title}
      <span class="accent">.</span>
    </h1>
    <p class="case-deck">{data.description}</p>
    <dl class="case-meta">
      <div>
        <dt>Bereich</dt>
        <dd>{data.category}</dd>
      </div>
      <div>
        <dt>Status / Jahr</dt>
        <dd>
          {data.status} · {data.year}
        </dd>
      </div>
      <div>
        <dt>Werkzeuge & Technologien</dt>
        <dd>{data.technologies.join(' · ')}</dd>
      </div>
      <div>
        <dt>{data.visual === 'shirt' ? 'Projektseite' : 'Quellcode'}</dt>
        <dd>
          {data.visual === 'shirt' && data.demoUrl ? (
            <a class="text-link" href={data.demoUrl}>
              little-detours.de ↗
            </a>
          ) : data.repositoryUrl ? (
            <a class="text-link" href={data.repositoryUrl}>
              Repository ansehen ↗
            </a>
          ) : (
            'Privates Repository'
          )}
        </dd>
      </div>
    </dl>
  </header>
  <div class="container">
    <figure class="case-figure">
      <div
        class:list={['case-cover', { 'life-cover': data.visual === 'life' }]}
      >
        {data.cover ? (
          <Image
            src={data.cover}
            alt={data.coverAlt || data.title}
            widths={[480, 800, 1200, 1500]}
            sizes="(max-width: 760px) 95vw, 85vw"
            format="webp"
            loading="eager"
          />
        ) : (
          <LifeDiagram />
        )}
      </div>
      <figcaption>
        {data.visual === 'hand'
          ? 'HaptIQ: Aufgezeichnete Griffe mit synthetischen Testdaten. Die gezeigte Platzierung ist vorläufig. Quelle: HaptIQ Hand.'
          : data.visual === 'shirt'
            ? 'KI-Konzeptbild auf Grundlage eines eigenen Motivs; kein Foto eines gefertigten Shirts.'
            : 'Konzeptzeichnung einer Population künstlicher Organismen. Kein Anwendungsscreenshot und kein Messergebnis.'}
      </figcaption>
    </figure>
  </div>
  <div class="reading-grid container">
    <aside class="reading-aside">
      <span class="eyebrow">IN DIESEM PROJEKT</span>
      <p>
        Hintergründe, Entscheidungen
        <br />
        und offene Fragen.
      </p>
      {data.demoUrl && <a href={data.demoUrl}>Projektwebsite ansehen ↗</a>}
      {data.links.map((link) => (
        <a href={link.url}>{link.label} ↗</a>
      ))}
    </aside>
    <article class="prose">
      <slot />
      {data.gallery.map((image) => (
        <figure>
          <Image
            src={image.src}
            alt={image.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 760px) 90vw, 740px"
            format="webp"
            loading="lazy"
          />
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      ))}
    </article>
  </div>
  <div class="container page-body">
    <a class="text-link" href="/projects/">
      Alle Projekte ansehen <span aria-hidden="true">↗</span>
    </a>
  </div>
</BaseLayout>
