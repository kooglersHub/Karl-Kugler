---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import ExhibitMedia from '../components/ExhibitMedia.astro';
import Arrow from '../components/Arrow.astro';
import { localPath } from '../lib/locale';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const data = project.data;
const en = data.locale === 'en';
const indexPath = localPath(data.locale, '/projects/');
---

<BaseLayout title={data.title} description={data.description}>
  <header class:list={['case-intro', 'container', `case-${data.visual}`]}>
    <a class="back-link" href={indexPath}>
      {en ? '← All projects' : '← Alle Projekte'}
    </a>
    <div class="case-title">
      <div>
        <p class="eyebrow">
          {data.category} / {data.year}
        </p>
        <h1>{data.title}</h1>
      </div>
      <p class="case-deck">{data.description}</p>
    </div>
    <dl class="case-meta">
      <div>
        <dt>Status</dt>
        <dd>{data.status}</dd>
      </div>
      <div>
        <dt>{en ? 'Tools' : 'Werkzeuge'}</dt>
        <dd>{data.technologies.join(' · ')}</dd>
      </div>
      <div>
        <dt>{en ? 'My contribution' : 'Mein Beitrag'}</dt>
        <dd>{data.contribution}</dd>
      </div>
    </dl>
  </header>
  <div class:list={['case-media', 'container', `case-media-${data.visual}`]}>
    <ExhibitMedia project={project} eager />
  </div>
  <div class="reading-grid container">
    <aside class="reading-aside">
      <span class="eyebrow">{en ? 'Project material' : 'Projektmaterial'}</span>
      {data.repositoryUrl && (
        <a class="text-link" href={data.repositoryUrl}>
          {en ? 'Source code' : 'Quellcode'}
          <Arrow />
        </a>
      )}
      {data.demoUrl && (
        <a class="text-link" href={data.demoUrl}>
          {en ? 'Project website' : 'Projektwebsite'}
          <Arrow />
        </a>
      )}
      {data.links.map((link) => (
        <a class="text-link" href={link.url}>
          {link.label}
          <Arrow />
        </a>
      ))}
      {!data.repositoryUrl && !data.demoUrl && !data.links.length && (
        <p>{en ? 'Repository is private.' : 'Das Repository ist privat.'}</p>
      )}
    </aside>
    <article class="prose">
      <slot />
      {data.gallery.map((image) => (
        <figure>
          <Image
            src={image.src}
            alt={image.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 720px) 92vw, 760px"
            format="webp"
            loading="lazy"
          />
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      ))}
    </article>
  </div>
  <div class="container page-body">
    <a class="text-link" href={indexPath}>
      {en ? 'Browse all projects' : 'Alle Projekte ansehen'}
      <Arrow />
    </a>
  </div>
</BaseLayout>
