---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
interface Props {
  article: CollectionEntry<'writing'>;
}
const { article } = Astro.props;
const data = article.data;
---

<BaseLayout title={data.title} description={data.description}>
  <div class="container">
    <header class="article-header">
      <a class="back-link" href="/writing/">
        ← ALLE NOTIZEN
      </a>
      <span class="eyebrow">{data.tags.join(' / ')}</span>
      <h1>{data.title}</h1>
      <p class="case-deck">{data.description}</p>
      <div class="article-meta mono">
        KARL KUGLER ·{' '}
        <time datetime={data.date.toISOString()}>
          {data.date.toLocaleDateString('de-DE', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </div>
    </header>
    <article class="article-prose prose">
      <slot />
    </article>
    <div class="article-rule">
      <a class="text-link" href="/writing/">
        Weitere Notizen <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</BaseLayout>
