---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { localPath } from '../lib/locale';
interface Props {
  article: CollectionEntry<'writing'>;
}
const { article } = Astro.props;
const data = article.data;
const en = data.locale === 'en';
const indexPath = localPath(data.locale, '/writing/');
---

<BaseLayout title={data.title} description={data.description}>
  <div class="container">
    <header class="article-header">
      <a class="back-link" href={indexPath}>
        {en ? '← All notes' : '← Alle Notizen'}
      </a>
      <p class="eyebrow">{data.tags.join(' / ')}</p>
      <h1>{data.title}</h1>
      <p class="case-deck">{data.description}</p>
      <p class="article-meta mono">
        Karl Kugler ·{' '}
        <time datetime={data.date.toISOString()}>
          {data.date.toLocaleDateString(en ? 'en-GB' : 'de-DE', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </p>
    </header>
    <article class="article-prose prose">
      <slot />
    </article>
    <div class="article-rule">
      <a class="text-link" href={indexPath}>
        {en ? 'More notes' : 'Weitere Notizen'}
        <Arrow />
      </a>
    </div>
  </div>
</BaseLayout>
