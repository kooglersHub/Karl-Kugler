---
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import { site, navigation } from '../config';
import { localeFor, localPath, otherLanguage } from '../lib/locale';
import Arrow from '../components/Arrow.astro';

interface Props {
  title?: string;
  description?: string;
  notFound?: boolean;
}

const { pathname } = Astro.url;
const locale = localeFor(pathname);
const en = locale === 'en';
const path = (route: string) => localPath(locale, route);
const {
  title,
  description = en ? site.descriptionEn : site.description,
  notFound = false,
} = Astro.props;
const pageTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} · ${en ? 'Mechatronics at KIT' : 'Mechatronik am KIT'}`;
const alternate = notFound
  ? en
    ? '/'
    : '/en/'
  : otherLanguage(pathname, locale);
const canonical =
  Astro.site && !notFound ? new URL(pathname, Astro.site) : undefined;
const alternateUrl = Astro.site && new URL(alternate, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3eb" />
    {!canonical && <meta name="robots" content="noindex, nofollow" />}
    {canonical && alternateUrl && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={locale} href={canonical} />
        <link rel="alternate" hreflang={en ? 'de' : 'en'} href={alternateUrl} />
        <link
          rel="alternate"
          hreflang="x-default"
          href={en ? alternateUrl : canonical}
        />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL('/social.png', canonical)} />
        <meta property="og:image:alt" content="Karl Kugler · Karlsruhe / KIT" />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={en ? 'en_GB' : 'de_DE'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark')
          document.documentElement.dataset.theme = 'dark';
      } catch {
        /* The light theme works without storage. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {en ? 'Skip to content' : 'Zum Inhalt'}
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="identity" href={path('/')}>
          Karl Kugler<span aria-hidden="true"></span>
        </a>
        <nav aria-label={en ? 'Main navigation' : 'Hauptnavigation'}>
          {navigation.map(({ href, ...label }) => (
            <a
              href={path(href)}
              aria-current={
                pathname.startsWith(path(href)) ? 'page' : undefined
              }
            >
              {label[locale]}
            </a>
          ))}
        </nav>
        <a
          class="language mono"
          href={alternate}
          lang={en ? 'de' : 'en'}
          hreflang={en ? 'de' : 'en'}
        >
          {en ? 'Deutsch' : 'English'}
        </a>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer forest">
      <div class="container">
        <div class="footer-top">
          <div>
            <span class="eyebrow">
              {en ? 'Contact · Karlsruhe' : 'Kontakt · Karlsruhe'}
            </span>
            <a class="footer-cta" href={`mailto:${site.email}`}>
              {site.email}
              <Arrow />
            </a>
          </div>
          <a class="text-link" href={path('/contact/')}>
            {en ? 'Ways to work together' : 'Formen der Zusammenarbeit'}
            <Arrow />
          </a>
        </div>
        <div class="footer-bottom">
          <span class="mono">© {new Date().getFullYear()} Karl Kugler</span>
          <div class="footer-links">
            <a href={path('/lab/')}>{en ? 'Lab' : 'Labor'}</a>
            <a href={path('/writing/')}>{en ? 'Notes' : 'Notizen'}</a>
            <a href={site.github}>GitHub</a>
            <a href={site.linkedin}>LinkedIn</a>
            <button
              class="theme-toggle"
              type="button"
              hidden
              data-dark={en ? 'Enable dark theme' : 'Dunkle Ansicht aktivieren'}
              data-light={
                en ? 'Enable light theme' : 'Helle Ansicht aktivieren'
              }
            ></button>
          </div>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const root = document.documentElement;
      const languageLink =
        document.querySelector<HTMLAnchorElement>('.language');
      if (languageLink) {
        const synchronizeLanguageLink = () => {
          const destination = new URL(languageLink.href);
          destination.search = location.search;
          destination.hash = location.hash;
          languageLink.href = destination.href;
        };
        synchronizeLanguageLink();
        window.addEventListener('hashchange', synchronizeLanguageLink);
      }
      function setThemeLabel(button: HTMLButtonElement) {
        button.textContent =
          root.dataset.theme === 'dark'
            ? button.dataset.light!
            : button.dataset.dark!;
      }
      if (toggle) {
        setThemeLabel(toggle);
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem('theme', root.dataset.theme);
          } catch {
            /* Only persistence needs storage. */
          }
          setThemeLabel(toggle);
        });
      }
    </script>
  </body>
</html>
