---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import { site, navigation } from '../config';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — Engineering field journal`;
const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" />
    <meta name="generator" content={Astro.generator} />
    {!Astro.site && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && (
      <meta property="og:image" content={new URL('/social.png', Astro.site)} />
    )}
    <meta
      property="og:image:alt"
      content="Karl Kugler — Curiosity, made tangible. Engineering field journal."
    />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.site && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'Person',
          name: site.name,
          url: Astro.site.href,
          sameAs: [site.github, site.linkedin],
        }).replaceAll('<', '\\u003c')}
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (
          theme === 'dark' ||
          (!theme && matchMedia('(prefers-color-scheme: dark)').matches)
        )
          document.documentElement.dataset.theme = 'dark';
      } catch {
        /* A blocked storage API should never prevent reading the page. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header container">
      <a class="identity" href="/">
        <svg
          class="identity-mark"
          width="28"
          height="28"
          viewBox="0 0 28 28"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 3v22M4 14 15 3M4 14l11 11M15 14 25 3M15 14l10 11"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
        <span>
          Karl Kugler
          <span class="identity-subtitle">ENGINEERING FIELD JOURNAL</span>
        </span>
      </a>
      <nav aria-label="Main navigation">
        {navigation.map(({ href, label }) => (
          <a
            href={href}
            aria-current={pathname.startsWith(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <button
          class="theme-toggle"
          aria-label="Switch to dark theme"
          title="Change color theme"
          hidden
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="8"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" />
          </svg>
        </button>
        <a class="contact-link" href="/contact/">
          Let’s talk <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <div class="footer-top">
        <a class="footer-signature" href="/">
          Karl Kugler<span class="accent">.</span>
        </a>
        <p>
          Always a work in progress.
          <br />
          That’s the interesting part.
        </p>
        <a class="text-link" href="/contact/">
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="footer-bottom mono">
        <span>© {new Date().getFullYear()} Karl Kugler</span>
        <span>BUILT WITH ASTRO · MADE TO EXPLORE</span>
        <div>
          <a href={site.github}>GitHub ↗</a>
          <a href={site.linkedin}>LinkedIn ↗</a>
          <a href="#main">Back to top ↑</a>
        </div>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      function updateThemeLabel() {
        button?.setAttribute(
          'aria-label',
          `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`,
        );
      }
      if (button) {
        button.hidden = false;
        updateThemeLabel();
        button.addEventListener('click', () => {
          const theme =
            document.documentElement.dataset.theme === 'dark'
              ? 'light'
              : 'dark';
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem('theme', theme);
          } catch {
            /* Theme remains usable for this page. */
          }
          updateThemeLabel();
        });
      }
    </script>
  </body>
</html>
