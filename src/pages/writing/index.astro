---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { formatMonthYear } from '../../lib/dates';
const notes = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Notizen"
  description="Technische Notizen zu Projekten, Software und den Entscheidungen dahinter."
>
  <header class="page-intro container">
    <span class="eyebrow">GEDANKEN AUS DER WERKSTATT</span>
    <h1>
      Gedanken, die
      <br />
      <em>weiterführen.</em>
    </h1>
    <p class="intro-description">
      Notizen zum Bauen, Beobachten und Verstehen. Entstanden neben der Arbeit
      an den Projekten.
    </p>
  </header>
  <section class="container page-body" aria-label="Artikel">
    <div class="note-list">
      {notes.map((note) => (
        <a class="note-row" href={`/writing/${note.data.slug}/`}>
          <span class="mono">{note.data.tags[0]}</span>
          <div>
            <h3>{note.data.title}</h3>
            <p>{note.data.description}</p>
            <time class="mono" datetime={note.data.date.toISOString()}>
              {formatMonthYear(note.data.date)}
            </time>
          </div>
          <Arrow />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
