---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99),
);
const categories = [
  'Alle Projekte',
  ...new Set(projects.map((project) => project.data.category)),
];
---

<BaseLayout
  title="Projekte"
  description="Eigene Projekte zwischen Robotik, Software, künstlichem Leben und Gestaltung."
>
  <div class="page-intro container">
    <span class="eyebrow">
      PROJEKTE / {String(projects.length).padStart(2, '0')} EINBLICKE
    </span>
    <h1>
      Ideen werden
      <br />
      <em>greifbar.</em>
    </h1>
    <p class="intro-description">
      Software, physische Systeme und Fragen, denen ich nachgehen möchte. Ein
      Blick auf die Arbeit und die Entscheidungen dahinter.
    </p>
  </div>
  <section class="page-body container" aria-label="Projektsammlung">
    <div class="filters" hidden aria-label="Nach Bereich filtern">
      {categories.map((category, index) => (
        <button type="button" data-filter={category} aria-pressed={index === 0}>
          {category}
        </button>
      ))}
      <span class="filter-status mono" role="status" aria-live="polite">
        {projects.length} Projekte
      </span>
    </div>
    <div class="projects-grid">
      {projects.map((project, index) => (
        <ProjectPreview project={project} index={index} />
      ))}
    </div>
    <p class="project-empty" hidden>
      In diesem Bereich gibt es noch keine Projekte.
    </p>
  </section>
  <script>
    const filters = document.querySelector<HTMLElement>('.filters');
    if (filters) {
      filters.hidden = false;
      const buttons = [
        ...filters.querySelectorAll<HTMLButtonElement>('[data-filter]'),
      ];
      const projects = [
        ...document.querySelectorAll<HTMLElement>('[data-category]'),
      ];
      for (const button of buttons)
        button.addEventListener('click', () => {
          let count = 0;
          for (const project of projects) {
            project.hidden =
              button.dataset.filter !== 'Alle Projekte' &&
              project.dataset.category !== button.dataset.filter;
            if (!project.hidden) count++;
          }
          for (const item of buttons)
            item.setAttribute('aria-pressed', String(item === button));
          const status = filters.querySelector('[role="status"]');
          if (status)
            status.textContent = `${count} ${count === 1 ? 'Projekt' : 'Projekte'}`;
          const empty = document.querySelector<HTMLElement>('.project-empty');
          if (empty) empty.hidden = count !== 0;
        });
    }
  </script>
</BaseLayout>
