---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="page-intro container not-found">
    <span class="eyebrow">404 / OUTSIDE THE MAP</span>
    <h1>
      A small
      <br />
      <em>wrong turn.</em>
    </h1>
    <p class="intro-description">
      This page isn’t here. The workbench is a good place to start again.
    </p>
    <a class="text-link mt-8" href="/">
      Back to the homepage <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>
