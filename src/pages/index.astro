---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { formatMonthYear } from '../lib/dates';
const projects = (await getCollection('projects'))
  .filter((p) => p.data.featuredOrder !== undefined)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);
const notes = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout>
  <section class="hero container">
    <div class="hero-top eyebrow">
      <span>
        <span class="status-dot"></span> SOFTWARE, HARDWARE & EVERYTHING BETWEEN
      </span>
      <span class="hero-index">FIELD NOTES / 001</span>
    </div>
    <h1>
      Curiosity,
      <br />
      <span class="hero-second">
        made <em>tangible.</em>
        <span class="hero-asterisk" aria-hidden="true">
          ✳
        </span>
      </span>
    </h1>
    <div class="hero-bottom">
      <span class="mono hero-scroll">
        SCROLL TO EXPLORE <span aria-hidden="true">↓</span>
      </span>
      <p>
        I’m Karl. I explore the space where software meets the physical world —
        through robotics, artificial life, and hands-on experiments.
      </p>
      <a class="round-link" href="/about/" aria-label="More about Karl">
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="selected-section container" aria-labelledby="selected-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">01 / SELECTED WORK</span>
        <h2 id="selected-title">
          Ideas, out in the world<span class="accent">.</span>
        </h2>
      </div>
      <a class="text-link" href="/projects/">
        All projects <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="featured-grid">
      {projects.map((project, index) => (
        <ProjectPreview
          project={project}
          index={index}
          prominent={index === 0}
        />
      ))}
    </div>
  </section>
  <section class="curiosity-section">
    <div class="container curiosity-grid">
      <div>
        <span class="eyebrow">02 / THE COMMON THREAD</span>
        <h2>
          Understanding things
          <br />
          by <em>building them.</em>
        </h2>
      </div>
      <div>
        <p class="large-copy">
          A robot hand. A population of digital organisms. A small experiment
          that asks a better question.
        </p>
        <p>
          Different materials, the same curiosity: how does it work, what can be
          measured, and what happens if we try something else?
        </p>
        <a class="text-link" href="/lab/">
          Step into the lab <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="container interest-strip mono">
      <span>ROBOTICS & ELECTRONICS</span>
      <span>SOFTWARE SYSTEMS</span>
      <span>ARTIFICIAL LIFE</span>
      <span>APPLIED AI</span>
    </div>
  </section>
  <section class="writing-section container" aria-labelledby="notes-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">03 / NOTES FROM THE WORKBENCH</span>
        <h2 id="notes-title">
          Thinking in the open<span class="accent">.</span>
        </h2>
      </div>
      <a class="text-link" href="/writing/">
        All writing <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="note-list">
      {notes.map((note, index) => (
        <a class="note-row" href={`/writing/${note.data.slug}/`}>
          <span class="mono note-number">0{index + 1}</span>
          <div>
            <span class="eyebrow">{note.data.tags.join(' / ')}</span>
            <h3>{note.data.title}</h3>
            <p>{note.data.description}</p>
          </div>
          <time class="note-date mono" datetime={note.data.date.toISOString()}>
            {formatMonthYear(note.data.date)}
          </time>
          <span class="note-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="contact-band container">
    <span class="eyebrow">HAVE SOMETHING IN MIND?</span>
    <div>
      <h2>
        Let’s make
        <br />
        <em>something click.</em>
      </h2>
      <a class="big-arrow" href="/contact/" aria-label="Get in touch">
        ↗
      </a>
    </div>
  </section>
</BaseLayout>
