---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { services } from '../lib/services';
import { site } from '../config';
import fern from '../assets/little-detours-fern.webp';
import hand from '../assets/haptiq-viewer.png';
const notes = await getCollection('writing');
---

<BaseLayout home>
  <section class="home-intro forest">
    <div class="container">
      <div class="hero-grid">
        <h1 class="hero-title">
          <span class="hero-line">
            <span>Hallo, ich bin Karl.</span>
          </span>
          <span class="hero-line">
            <span>Websites. Technik.</span>
          </span>
          <span class="hero-line">
            <span>Mittendrin.</span>
          </span>
        </h1>
        <div class="hero-aside">
          <p>
            Aus Karlsruhe.
            <br />
            Für digitale Projekte, technische Aufgaben und Einsätze auf Messen
            und Events.
          </p>
          <a class="button" href="/contact/">
            Zusammenarbeiten
            <Arrow />
          </a>
          <span class="mono">Deutsch · Englisch</span>
        </div>
      </div>
      <div class="service-list" id="leistungen" aria-label="Meine Leistungen">
        {services.map((service, index) => (
          <a class="service-row" href={`/contact/?anliegen=${service.id}`}>
            <span class="service-number">0{index + 1}</span>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
            <Arrow direction="right" />
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="work-section container" aria-label="Eigene Projekte">
    <article class="work-spread shirt-spread" data-reveal>
      <div class="work-copy">
        <span class="eyebrow">MEIN DESIGNPROJEKT</span>
        <h2>little detours</h2>
        <p>
          Naturmotive auf Shirts, inspiriert von kleinen Entdeckungen und dem
          Interesse an der Welt um uns herum.
        </p>
        <a class="text-link" href={site.shirts}>
          little-detours.de
          <Arrow />
        </a>
        <span class="project-note mono">KI-Konzeptbild · Shop-Vorschau</span>
        <a class="quiet-link" href="/projects/little-detours/">
          Die Idee dahinter
        </a>
      </div>
      <a class="work-image shirt-image" href="/projects/little-detours/">
        <Image
          src={fern}
          alt="KI-Konzeptbild: Cremefarbenes Shirt mit botanischem Farnmotiv auf felsigem Untergrund."
          widths={[480, 800, 1200, 1703]}
          sizes="(max-width: 760px) 100vw, 62vw"
          format="webp"
          loading="eager"
        />
      </a>
    </article>
    <article class="work-spread hand-spread" data-reveal>
      <a class="work-image hand-image" href="/projects/haptiq-hand/">
        <Image
          src={hand}
          alt="HaptIQ-Viewer mit einer robotischen Hand und taktilen Messpunkten; synthetische Testdaten."
          widths={[480, 800, 1200, 1500]}
          sizes="(max-width: 760px) 100vw, 60vw"
          format="webp"
          loading="lazy"
        />
      </a>
      <div class="work-copy">
        <span class="eyebrow">SOFTWARE TRIFFT ROBOTIK</span>
        <h2>HaptIQ Hand</h2>
        <p>
          Taktile Telemetrie für eine robotische Hand. Aufgezeichnete Griffe
          sichtbar machen und sensorbasierte Schätzungen mit CAD-Daten
          verbinden.
        </p>
        <a class="text-link" href="/projects/haptiq-hand/">
          Zum Projekt
          <Arrow />
        </a>
        <span class="project-note mono">Python · JavaScript · WebGL</span>
      </div>
    </article>
    <div class="more-work" data-reveal>
      <span class="eyebrow">ES GIBT NOCH MEHR ZU ENTDECKEN</span>
      <a href="/projects/evolab/">
        <span>EvoLab</span>
        <span>Eine kleine Welt für große Fragen.</span>
        <Arrow />
      </a>
      <a href="/projects/">
        <span>Alle Projekte</span>
        <span>Hintergründe, Entscheidungen und offene Fragen.</span>
        <Arrow />
      </a>
    </div>
  </section>
  <section class="personal-section forest">
    <div class="container personal-grid" data-reveal>
      <span class="eyebrow">TECHNIK. KREATIVITÄT. VOR ORT.</span>
      <div>
        <h2>
          Ich denke mich rein.
          <br />
          Und packe mit an.
        </h2>
        <p>
          Mich interessiert, wie Dinge funktionieren – und was daraus werden
          kann. Mal ist das eine Website, mal eine technische Aufgabe, mal ein
          Einsatz mit Menschen. Erzähl mir, wobei du Unterstützung brauchst.
        </p>
        <a class="text-link" href="/about/">
          Mehr über mich
          <Arrow />
        </a>
      </div>
    </div>
  </section>
  <section class="notes-section container" data-reveal>
    <div class="section-heading">
      <span class="eyebrow">GEDANKEN AUS DER WERKSTATT</span>
      <a class="text-link" href="/writing/">
        Alle Notizen
        <Arrow />
      </a>
    </div>
    {notes.map((note) => (
      <a class="note-row" href={`/writing/${note.data.slug}/`}>
        <span class="mono">{note.data.tags[0]}</span>
        <h2>{note.data.title}</h2>
        <Arrow />
      </a>
    ))}
  </section>
</BaseLayout>
