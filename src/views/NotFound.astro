---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeFor, localPath } from '../lib/locale';

const locale = localeFor(Astro.url.pathname);
const en = locale === 'en';
---

<BaseLayout title={en ? 'Page not found' : 'Seite nicht gefunden'} notFound>
  <section class="page-intro container not-found">
    <p class="eyebrow">404</p>
    <h1>{en ? 'Page not found' : 'Seite nicht gefunden'}</h1>
    <p class="intro-description">
      {en
        ? 'Find the projects from the home page.'
        : 'Die Startseite führt zurück zu den Projekten.'}
    </p>
    <a class="text-link" href={localPath(locale, '/')}>
      {en ? 'Back to home' : 'Zur Startseite'} <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>
